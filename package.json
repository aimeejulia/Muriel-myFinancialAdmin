{
  "name": "muriel-myfinancialadmin",
  "version": "1.2.0",
  "description": "Muriel - myFinancialAdmin desktop app",
  "main": "main.js",
  "author": "Aimee Fenech",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/aimeejulia/Muriel-myFinancialAdmin",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimeejulia/Muriel-myFinancialAdmin.git"
  },
  "scripts": {
    "preinstall": "node ./scripts/check-node.js",
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "clean:dist": "rm -rf dist",
    "lint": "eslint .",
    "release": "node ./scripts/release.js",
    "check:appimage-config": "node ./scripts/validate-appimage-config.js",
    "check:release-version": "node ./scripts/validate-release-version.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=60000 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/*.e2e.mjs",
    "package:appimage": "npm run clean:dist && npm run check:appimage-config && npm run check:release-version && electron-builder --linux AppImage",
    "package:linux": "npm run clean:dist && npm run check:appimage-config && npm run check:release-version && electron-builder --linux",
    "package:flatpak": "npm run clean:dist && npm run check:appimage-config && npm run check:release-version && electron-builder --linux flatpak",
    "package:snap": "npm run clean:dist && npm run check:appimage-config && npm run check:release-version && electron-builder --linux snap"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0",
  "volta": {
    "node": "22.12.0",
    "npm": "10.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "com.muriel.myfinancialadmin",
    "productName": "Muriel - myFinancialAdmin",
    "icon": "build/icon.png",
    "files": [
      "index.html",
      "styles.css",
      "MURIEL.jpg",
      "renderer.js",
      "state.js",
      "views.js",
      "profile.js",
      "reports.js",
      "pdf.js",
      "imports.js",
      "pdf-reader.js",
      "update-banner.js",
      "main.js",
      "state-file.js",
      "update-info.js",
      "source-update.js",
      "preload.js",
      "build/icon.png",
      "vendor/pdfjs/pdf.min.mjs",
      "vendor/pdfjs/pdf.worker.min.mjs"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "aimeejulia",
      "repo": "Muriel-myFinancialAdmin",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "flatpak",
        "snap"
      ],
      "category": "Office",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "Name": "Muriel - myFinancialAdmin",
          "Comment": "Local-first financial admin desktop app",
          "Categories": "Office;Finance;",
          "StartupWMClass": "Muriel - myFinancialAdmin"
        }
      }
    },
    "appImage": {
      "artifactName": "Muriel-myFinancialAdmin-${version}.${ext}"
    },
    "flatpak": {
      "artifactName": "Muriel-myFinancialAdmin-${version}-${arch}.${ext}",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "baseVersion": "24.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.secrets"
      ]
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "Local-first financial admin desktop app"
    }
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.8.69"
  }
}
