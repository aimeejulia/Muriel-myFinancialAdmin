{
  "name": "muriel-myfinancialadmin",
  "version": "1.1.1",
  "description": "Muriel - myFinancialAdmin desktop app",
  "main": "main.js",
  "author": "Aimee Fenech",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/aimeejulia/Muriel-myFinancialAdmin",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimeejulia/Muriel-myFinancialAdmin.git"
  },
  "scripts": {
    "preinstall": "node ./scripts/check-node.js",
    "start": "electron .",
    "dev": "electron .",
    "check:appimage-config": "node ./scripts/validate-appimage-config.js",
    "package:appimage": "npm run check:appimage-config && electron-builder --linux AppImage",
    "package:linux": "npm run check:appimage-config && electron-builder --linux",
    "package:flatpak": "electron-builder --linux flatpak",
    "package:snap": "electron-builder --linux snap"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0",
  "volta": {
    "node": "22.12.0",
    "npm": "10.9.0"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.muriel.myfinancialadmin",
    "productName": "Muriel - myFinancialAdmin",
    "icon": "build/icon.png",
    "files": [
      "index.html",
      "styles.css",
      "MURIEL.jpg",
      "renderer.js",
      "state.js",
      "views.js",
      "profile.js",
      "reports.js",
      "pdf.js",
      "imports.js",
      "main.js",
      "preload.js",
      "build/icon.png",
      "vendor/pdfjs/pdf.min.mjs",
      "vendor/pdfjs/pdf.worker.min.mjs"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "aimeejulia",
      "repo": "Muriel-myFinancialAdmin",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "flatpak",
        "snap"
      ],
      "category": "Office",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "Name": "Muriel - myFinancialAdmin",
          "Comment": "Local-first financial admin desktop app",
          "Categories": "Office;Finance;",
          "StartupWMClass": "Muriel - myFinancialAdmin"
        }
      }
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk"
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "Local-first financial admin desktop app"
    }
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.8.69"
  }
}
